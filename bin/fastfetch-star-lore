#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s <category> [--config <fastfetch-config>]\n' "${0##*/}"
  printf 'Available categories: stargate, star-trek, independence-day, random (or all)\n'
}

category=${1:-stargate}
if [[ $# -gt 0 ]]; then shift; fi

config=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --config|-c)
      [[ $# -ge 2 ]] || { printf '%s requires a path\n' "$1" >&2; exit 2; }
      config=(--config "$2")
      shift 2
      ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

renderer_mode=${STAR_LORE_RENDERER:-}
if [[ -z $renderer_mode ]]; then
  settings_file="${XDG_CONFIG_HOME:-"$HOME/.config"}/fastfetch-star-lore/config"
  if [[ -r $settings_file ]]; then
    renderer_mode=$(awk -F= '$1 == "renderer" { print $2; exit }' "$settings_file")
  fi
fi
case $renderer_mode in
  ''|sprite|raw) ;;
  *) printf 'Invalid configured renderer: %s\n' "$renderer_mode" >&2; exit 2 ;;
esac

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(cd -- "$(dirname -- "$script_path")" && pwd)
art_dir=$(cd -- "$script_dir/../art" && pwd)

case $category in
  random|all)
    categories=(stargate star-trek independence-day)
    category=${categories[RANDOM % ${#categories[@]}]}
    ;;
esac

case $category in
  stargate)
    # Kitty can preserve the full-color pixel art; other terminals retain the
    # portable ANSI renderer.
    if [[ "${TERM:-}" == xterm-kitty* && "${renderer_mode:-sprite}" == sprite ]]; then
      sprite=$(zsh "$art_dir/stargate/select-sprite.zsh")
      case ${sprite##*/} in
        active-stargate.png) quote='"Anything as powerful as the Stargate deserves respect."' ;;
        dhd.png) quote='"This time there really are barbarians."' ;;
        zpm.png) quote='"The most important thing in the universe."' ;;
        hand-device.png) quote='"We have to try."' ;;
        staff-weapon.png) quote='"Weapons are at maximum."' ;;
        ancient-chair.png) quote='"The answer is in there."' ;;
        malp.png) quote='"We can send objects through."' ;;
        atlantis-city.png) quote='"If they come in ships, we will not be any match for them."' ;;
        atlantis-gate.png) quote='"They really are at the gate."' ;;
        puddle-jumper.png) quote='"Use your imagination."' ;;
        universe-gate.png) quote='"The light is turned off."' ;;
        destiny.png) quote='"I wish you all well."' ;;
        alkesh.png) quote='"We must not let this fall into the hands of Anubis."' ;;
      esac
      fastfetch "${config[@]}" --kitty "$sprite" --logo-width 38 --logo-height 18
      printf '\n%s\n' "$quote"
      exit 0
    fi
    renderer="$art_dir/stargate/art.zsh"
    ;;
  star-trek)
    if [[ "${TERM:-}" == xterm-kitty* && "${renderer_mode:-sprite}" == sprite ]]; then
      sprite=$(zsh "$art_dir/star-trek/select-sprite.zsh")
      case ${sprite##*/} in
        federation-starship.png) quote='"Risk is our business."' ;;
        klingon-bird-of-prey.png) quote='"The future is what we make it."' ;;
        vulcan-science-vessel.png) quote='"Logic is the beginning of wisdom, not the end."' ;;
        tricorder-sprite.png) quote='"The needs of the many outweigh the needs of the few."' ;;
        transporter.png) quote="\"I don't believe in the no-win scenario.\"" ;;
        vulcan-salute.png) quote='"Live long and prosper."' ;;
      esac
      fastfetch "${config[@]}" --kitty "$sprite" --logo-width 38 --logo-height 18
      printf '\n%s\n' "$quote"
      exit 0
    fi
    renderer="$art_dir/star-trek/art.zsh"
    ;;
  independence-day)
    if [[ "${TERM:-}" == xterm-kitty* && "${renderer_mode:-sprite}" == sprite ]]; then
      sprite=$(zsh "$art_dir/independence-day/select-sprite.zsh")
      # Match the compact Kitty cell budget used by the working Stargate path.
      case ${sprite##*/} in
        mothership.png) quote='"We will not go quietly into the night."' ;;
        interceptor.png) quote='"Welcome to Earth!"' ;;
        alien-ambassador.png) quote='"Today, we celebrate our Independence Day!"' ;;
        city-beam.png) quote='"We are still here."' ;;
        resistance-interceptor.png) quote='"Today, we fight together."' ;;
        signal-beacon.png) quote='"The signal is ours now."' ;;
      esac
      fastfetch "${config[@]}" --kitty "$sprite" --logo-width 38 --logo-height 18
      printf '\n%s\n' "$quote"
      exit 0
    fi
    renderer="$art_dir/independence-day/art.zsh"
    ;;
  star-wars)
    printf 'The %s category is reserved but has no art yet.\n' "$category" >&2
    exit 1
    ;;
  *) printf 'Unknown category: %s\n' "$category" >&2; usage >&2; exit 2 ;;
esac

zsh "$renderer" | fastfetch "${config[@]}" \
  --logo-type file-raw --logo-height 11 --logo-width 28 --logo -
